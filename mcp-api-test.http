###############################################################################
# 海典 MCP 接口对接与测试文档
# 用途：自测 + 交付客户对接。多数为 POST（JSON）；群联调章节 〇 含 GET 查询。
# 环境：将 @BASE 改为实际服务地址，本地测试可用 http://localhost:8085
###############################################################################

@BASE = https://yfzt.antissoft.com
@ACCESS_TOKEN = mcp-yifeng-fixed-bearer-7Kp9mN2xQ4vL8wR3sT6jH1gF5dC0bA

###############################################################################
# 0、先获取 OAuth Token（MCP接口）
# 说明：
# 1) 此接口无需 Bearer；
# 2) 复制响应里的 access_token，填到 @ACCESS_TOKEN；
# 3) 后续受保护接口统一加：Authorization: Bearer {{ACCESS_TOKEN}}
###############################################################################

### 0-0 获取Token（MCP风格）
POST {{BASE}}/mcp/core_oauth_token
Content-Type: application/json

{
  "grant_type": "client_credentials",
  "client_id": "mcp-client",
  "client_secret": "change-me-please"
}

###############################################################################
# 〇、群名称 + 分词 + 下单备注 + 群昵称 — 完整联调（参数已写满，按顺序点「运行」即可）
#
# 【前提】海典同步库已执行 db/mcp_chat_group_config.sql（配置表 + 订单表扩展列）；本服务连的是该库。
# 【顺序】步骤 1 → 2 → 3 → 4（5、6 可任选，与 3、4 等价不同入口）。
# 【说明】groupName 必须与步骤 1 里 groupName 完全一致，才会按 segmentWords 拆成分词写入检索字段。
#         查询时 groupToken 必须是 segmentWords 里某一个完整词（如「恒瑞」），不要带空格或半段字。
# 【重跑】若步骤 1 报群名称已存在（唯一键），请先 DELETE 该配置，或把步骤 1、2 里两个 groupName 改成同一新字符串。
###############################################################################

### 〇-1 保存群配置（维护分词，与真实群名对齐）
# groupName：业务侧下单时传入的群名称，须与此处一致（精确匹配，区分大小写按库 utf8mb4）
# segmentWords：JSON 数组字符串，每个元素是一个检索词；下单后 group_tokens_search 会包含 |恒瑞|成都| 等形式
# chatId / storeCode / configRemark：可选，便于运营备注
POST {{BASE}}/mcp/chat-group-config/save
Content-Type: application/json
Authorization: Bearer {{ACCESS_TOKEN}}

{
  "groupName": "一丰恒瑞患者服务群-成都旗舰店",
  "chatId": "wxwork_chat_G20260324_demo",
  "segmentWords": "[\"一丰\",\"恒瑞\",\"成都\",\"旗舰店\",\"患者服务\"]",
  "storeCode": "STORE_CD_001",
  "configRemark": "HTTP 联调用例：分词用于按「恒瑞」「成都」等筛选待审核订单"
}

### 〇-2 下单（REST，仅支持 chatInfo 传群字段；药品可留空数组走待审核补药）
# patientName / patientPhone：患者信息
# chatInfo.roomName：群名（必须与 〇-1 中 groupName 完全一致）
# chatInfo.remark：下单备注
# chatInfo.senderName：用户在群里的昵称
# items：此处给空数组，便于只测群字段；若要测有药下单可改成与非空 items 示例相同
POST {{BASE}}/mcp/core_order_create
Content-Type: application/json
Authorization: Bearer {{ACCESS_TOKEN}}

{
  "chatInfo": {
    "senderName": "李测试-家属（群昵称示例）",
    "remark": "患者急用，请优先审核；来源：企业微信群下单",
    "roomName": "一丰恒瑞患者服务群-成都旗舰店"
  },
  "patientName": "联调患者李测试",
  "patientPhone": "13800138001",
  "patientIdCard": "510105199001011234",
  "patientEducation": "餐后温水送服",
  "items": []
}

### 发货登记 core_shipment_create（姓名、地址、电话、邮寄方式必填；支持多药品 items）
# 落库：海典库 mcp_shipment_request_log；页面「MCP 订单与发货」→「发货登记」可查看、编辑、点「发货」改状态
POST {{BASE}}/mcp/core_shipment_create
Content-Type: application/json
Authorization: Bearer {{ACCESS_TOKEN}}

{
  "recipientName": "张三",
  "recipientPhone": "13900001111",
  "address": "四川省成都市高新区示例路99号",
  "shipMethod": "顺丰标快",
  "remark": "备注可选",
  "items": [
    {
      "drugName": "阿莫西林胶囊",
      "spec": "0.25g*24粒",
      "qty": 2,
      "barCode": "6931435340413"
    },
    {
      "name": "蒙脱石散",
      "quantity": 1,
      "spec": "3g*10袋"
    }
  ]
}

### 〇-2A 下单（你当前用户侧真实格式：chatInfo + items 字符串 "[]"）
# 验证点：
# 1) chatInfo.roomName -> group_name
# 2) chatInfo.remark -> order_context_remark
# 3) chatInfo.senderName -> user_group_nickname
# 4) items 为字符串 "[]" 也能正常落库并进入待审核
POST {{BASE}}/mcp/core_order_create
Content-Type: application/json
Authorization: Bearer {{ACCESS_TOKEN}}

{
  "chatInfo": {
    "senderName": "帅气的王大爷",
    "remark": "测试音频文件",
    "roomName": "一丰二医院患者支援群旗舰店"
  },
  "patientPhone": "13881748461",
  "patientIdCard": "510111197209161293",
  "items": "[]"
}

### 〇-2B 下单（chatInfo + items 真数组，顺便测药品归一化）
POST {{BASE}}/mcp/core_order_create
Content-Type: application/json
Authorization: Bearer {{ACCESS_TOKEN}}

{
  "chatInfo": {
    "senderName": "李先生（本人）",
    "remark": "请尽快审核，上午要用药",
    "roomName": "一丰恒瑞患者服务群-成都旗舰店"
  },
  "patientPhone": "13800138112",
  "patientName": "chatInfo格式测试-李二",
  "patientIdCard": "510105199202022222",
  "items": [
    {
      "name": "阿莫西林胶囊",
      "quantity": 2,
      "spec": "0.25g*24粒",
      "barCode": "6931435340413"
    },
    {
      "drugName": "蒙脱石散",
      "qty": 1,
      "spec": "3g*10袋"
    }
  ]
}

### 〇-3 按分词查询待审核订单（仅 audit_status=0，等价 tools/call：core_order_query_by_group_token）
# groupToken：必须是 〇-1 里 segmentWords 中的某一个，例如「恒瑞」或「成都」
GET {{BASE}}/mcp/order-query-by-group-token?groupToken=恒瑞
Authorization: Bearer {{ACCESS_TOKEN}}

### 〇-4 审核列表 + 状态筛选 + 分词（页面「刷新」同款接口）
# status=0：待审核；groupToken：同上，与配置分词一致
GET {{BASE}}/mcp/order-audit-list?status=0&groupToken=恒瑞

### 〇-5 JSON-RPC：按分词查待审核（MCP 工具 core_order_query_by_group_token）
POST {{BASE}}/mcp/rpc
Content-Type: application/json
Authorization: Bearer {{ACCESS_TOKEN}}
Authorization: Bearer {{ACCESS_TOKEN}}
Authorization: Bearer {{ACCESS_TOKEN}}

{
  "jsonrpc": "2.0",
  "id": 901,
  "method": "tools/call",
  "params": {
    "name": "core_order_query_by_group_token",
    "arguments": {
      "groupToken": "成都"
    }
  }
}


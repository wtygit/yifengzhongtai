Content-Type: application/json
Authorization: Bearer {{ACCESS_TOKEN}}
Authorization: Bearer {{ACCESS_TOKEN}}
Authorization: Bearer {{ACCESS_TOKEN}}

{
  "jsonrpc": "2.0",
  "id": 902,
  "method": "tools/call",
  "params": {
    "name": "core_order_create",

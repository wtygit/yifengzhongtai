### 小程序回调：更新订单状态（海典同步库表B：mcp_order_create_order_log）
# 参数：orderId 或 pendingId 至少一个；statusCode 对照：1预下单 2已领单 3配送中 4待上传凭证 5完成 6驳回 7已退单
POST {{BASE}}/mcp/core_order_status_update
Content-Type: application/json
Authorization: Bearer {{ACCESS_TOKEN}}

{
  "orderId": "PD-2026-03-17-58179780",
  "statusCode": 5,
  "receiverName": "张三",
  "completionImagesJson": "{\"images\":[\"https://xx/a.jpg\",\"https://xx/b.jpg\"]}",
  "invoiceInfo": "{\"title\":\"四川某某公司\",\"taxNo\":\"9151xxxx\",\"email\":\"xx@xx.com\",\"needInvoice\":true}",
  "callbackData": "{\"payChannel\":\"wx\",\"transactionId\":\"420000xxxx\",\"payTime\":\"2026-03-19 10:11:12\"}"
}

###############################################################################
# 工具清单：core_order_query | core_insurance_query | core_drug_query | core_visit_strategy_query | core_order_create | core_profile_create
# 统一响应：{ "code": 0 成功 / 4xx 参数或业务错误 / 5xx 服务错误, "msg": "说明", "data": 业务数据或 null }
# 重复建档：code=409，msg="该身份证已建档，无需重复提交"
#
# 下单审计（双表）：
# - 表A/B 落在海典同步库（haidian.datasource），非 jimureport 主库
# - 表A mcp_order_create_request_log：保存用户传入原始下单数据
# - 表B mcp_order_create_order_log：保存我方生成订单数据 + 中台响应 + 小程序回调数据
# 部署前请在海典同步库执行：db/mcp_order_create_log.sql、db/mcp_chat_group_config.sql（群配置 + 订单表群字段/分词检索列）
###############################################################################

### 身份证触发下单（REST）测试
# 说明：
# 1) requestTriggerType=idcard；
# 2) patientPhone 留空，仅用身份证触发；
# 3) 身份证触发=私聊单：不传 roomName/groupName；但要能带出门店、备注、昵称、患教、药品信息；
# 4) 审核页应出现在「订单审核（身份证）」Tab，且不展示「群名称」列。
POST {{BASE}}/mcp/core_order_create
Content-Type: application/json
Authorization: Bearer {{ACCESS_TOKEN}}

{
  "requestTriggerType": "idcard",
  "chatInfo": {
    "storeId": "10396",
    "remark": "私聊身份证下单备注：请尽快处理",

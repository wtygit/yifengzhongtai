      },
      "patientName": "联调患者王测试",
      "patientPhone": "13800138002",
      "patientIdCard": "510105199002022345",
      "items": [
        {
          "drugName": "连花清瘟胶囊",
          "spec": "0.35g*24粒",
          "qty": 1,

        }
      ]
    }
  }
}

### 〇-7 拉取当前全部群配置（核对 segment_words 是否生效）
GET {{BASE}}/mcp/chat-group-config/list
Authorization: Bearer {{ACCESS_TOKEN}}

###############################################################################
# 一、MCP 协议（JSON-RPC 2.0）— 单端点 POST {{BASE}}/mcp/rpc
###############################################################################

### 握手 initialize
# 入参：protocolVersion、capabilities、clientInfo
POST {{BASE}}/mcp/rpc
Content-Type: application/json
Authorization: Bearer {{ACCESS_TOKEN}}
Authorization: Bearer {{ACCESS_TOKEN}}

{
  "jsonrpc": "2.0",
  "id": 1,
  "method": "initialize",
  "params": {
    "protocolVersion": "2024-11-05",
    "capabilities": {},
    "clientInfo": { "name": "client-name", "version": "1.0" }
  }
}

### 客户端确认 initialized（可选）
POST {{BASE}}/mcp/rpc
Content-Type: application/json
Authorization: Bearer {{ACCESS_TOKEN}}
Authorization: Bearer {{ACCESS_TOKEN}}

{
  "jsonrpc": "2.0",
  "method": "initialized"
}

### 获取工具列表 tools/list
# 入参：无
POST {{BASE}}/mcp/rpc
Content-Type: application/json
Authorization: Bearer {{ACCESS_TOKEN}}

{
  "jsonrpc": "2.0",
  "id": 2,
  "method": "tools/list",
  "params": {}
}

###############################################################################
# 二、tools/call 调用各接口（统一单端点 POST {{BASE}}/mcp/rpc）
